# Copy this file to .env in the same directory and fill in your keys.
# All keys are optional — the pipeline works without them but will be rate-limited.
#
# Semantic Scholar: raises the API rate limit significantly.
# Get a free key at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Used during abstract recovery (optional, only needed if running with --api-recovery)
CORE_API_KEY=
OPENALEX_API_KEY=
UNPAYWALL_EMAIL=
CROSSREF_EMAIL=
